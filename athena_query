SELECT
    substring(request_at, 1, 10) AS usage_day,
    client_id,
    CASE
        WHEN url_decode(request_path) LIKE '/api/v1/profiles/%/'
            THEN 'Profile details'
        WHEN url_decode(request_path) LIKE '//api/v1/profiles/%/'
            THEN 'Profile details'
        ELSE url_decode(request_path)
    END AS api_call,
    COUNT(*) AS request_count
FROM profile_requests
WHERE request_at >= '2026-06-01'
  AND request_at <  '2027-01-01'
GROUP BY 1, 2, 3
ORDER BY 1, 2, 4 DESC;